# Copy to .env (never commit .env). Placeholders only.

# Fine-grained personal access token. Optional for public repos (60 req/h),
# required for private repos, code search and write tools.
GITHUB_TOKEN=

GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_REQUEST_TIMEOUT=30
GITHUB_MAX_RETRIES=3

# Write tools (create issue/comment/branch/PR). Disabled unless set to true.
GITHUB_ENABLE_WRITE_TOOLS=false

# DEBUG | INFO | WARNING | ERROR  (logs go to stderr)
GITMCP_LOG_LEVEL=INFO

# Optional limits
# GITMCP_MAX_FILE_BYTES=200000
# GITMCP_MAX_PATCH_CHARS=8000
# GITMCP_MAX_COMMENT_CHARS=4000
# GITMCP_MAX_RESPONSE_BYTES=5000000
# GITHUB_MAX_RATE_LIMIT_WAIT=60

# Optional integration tests (tests/test_integration.py)
# GITMCP_TEST_TOKEN=
# GITMCP_TEST_REPO=owner/repo
